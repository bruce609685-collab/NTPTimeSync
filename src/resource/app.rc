#include <windows.h>
#include "resource.h"

#ifdef INTRANET_BUILD
#define EDITION_STR " 内网版"
#else
#define EDITION_STR ""
#endif

IDI_APP ICON "app.ico"

// Language packs: external in the source tree (lang\<code>.ini), compiled into the exe.
// Adding a translation = drop the file here (and in i18n.cpp kLangs), no C++ changes.
IDR_LANG_ZHCNT RCDATA "../../lang/zh-CN.ini"
IDR_LANG_ZHTW  RCDATA "../../lang/zh-TW.ini"
IDR_LANG_FR    RCDATA "../../lang/fr-FR.ini"
IDR_LANG_IT    RCDATA "../../lang/it-IT.ini"
IDR_LANG_RU    RCDATA "../../lang/ru-RU.ini"
IDR_LANG_JA    RCDATA "../../lang/ja-JP.ini"

#ifdef DEV_BUILD
1 RT_MANIFEST "app_dev.manifest"
#else
1 RT_MANIFEST "app.manifest"
#endif

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "NTP Time Sync Tool"
            VALUE "FileDescription", "NTP 时间同步校准工具" EDITION_STR
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "NTPTimeSync"
            VALUE "OriginalFilename", "NTPTimeSync.exe"
            VALUE "ProductName", "NTP 时间同步校准工具" EDITION_STR
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

IDD_ADD DIALOGEX 0, 0, 240, 104
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "添加 NTP 服务器"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "名称（可留空）：", -1, 12, 16, 66, 10
    EDITTEXT        IDC_ADD_NAME, 82, 14, 146, 14, ES_AUTOHSCROLL
    LTEXT           "服务器地址：", -1, 12, 38, 66, 10
    EDITTEXT        IDC_ADD_ADDR, 82, 36, 146, 14, ES_AUTOHSCROLL
    LTEXT           "填写域名或 IP 地址。默认端口 123，需要时可写成 域名:端口。", IDC_ADD_HINT, 82, 54, 148, 22
    DEFPUSHBUTTON   "确定", IDOK, 122, 82, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 178, 82, 50, 14
END
